# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# BeatAPI key, created at https://beatapi.io/dashboard/apikeys
# Server-side only: it is never logged and never sent to Telegram.
BEATAPI_API_KEY=

# webhook = FastAPI server (Railway / Render / Fly.io / any VPS)
# polling = long polling (GitHub Actions, home server, laptop)
MODE=webhook

# Public HTTPS URL that Telegram should call. The path is the webhook route.
# Required when MODE=webhook; ignored in polling mode.
WEBHOOK_URL=https://your.domain/webhook

# HTTP port for the webhook server.
PORT=8443

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional tuning — the defaults below are production-safe; uncomment to change.
# ---------------------------------------------------------------------------

# Upstream API origin (do not change unless you use a proxy).
# BEATAPI_BASE_URL=https://api.beatapi.io

# HTTP timeout, retries and backoff for BeatAPI calls.
# BEATAPI_TIMEOUT_SECONDS=60
# BEATAPI_MAX_RETRIES=2
# BEATAPI_RETRY_BACKOFF_SECONDS=1.5
# BEATAPI_MAX_RETRY_AFTER_SECONDS=30

# Async task polling: 5–10 seconds with jitter, 15 minutes maximum.
# POLL_INTERVAL_MIN_SECONDS=5
# POLL_INTERVAL_MAX_SECONDS=10
# POLL_TIMEOUT_SECONDS=900
# PROGRESS_UPDATE_SECONDS=20

# Result delivery limits (Telegram bots can upload 50 MB at most).
# MAX_DOWNLOAD_BYTES=50331648
# MAX_RESULT_CHARS=3500
# MAX_ATTACHMENTS=3

# Optional override for the Telegram webhook secret token. When empty, a
# secret is derived from TELEGRAM_BOT_TOKEN automatically.
# WEBHOOK_SECRET_TOKEN=

# Restrict the bot to specific Telegram user ids (comma separated).
# Leave empty to allow everyone. Find your id with @userinfobot.
# ALLOWED_USER_IDS=

# Per-user command rate limit (requests per minute, 0 disables).
# RATE_LIMIT_PER_MINUTE=20

# Stop polling gracefully after N seconds. Used by .github/workflows/run-bot.yml
# to restart before GitHub's 6-hour job limit (19800 s = 5 h 30 min).
# POLLING_MAX_RUNTIME_SECONDS=0

# How many Telegram updates are processed concurrently.
# CONCURRENT_UPDATES=32

# How long a /search session stays valid before /run asks you to search again.
# SESSION_TTL_SECONDS=3600
